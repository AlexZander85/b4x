# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test
.task/

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Editor/IDE
# .idea/
# .vscode/

src/tools/docs/
src/embed

src/b4

out/
vendor/
# E-H3 (owner mandate: dependencies stored in the project): keep src/vendor
# tracked despite the blanket vendor/ rule above.
!src/vendor/
!src/vendor/**

#Ignore vscode AI rules
.github/instructions/codacy.instructions.md
tspu-docs/
.claude/

# Python field-validation artifacts
__pycache__/
*.pyc

# Agent session state
/.ag/

# agent session state (OpenCode).ag/

# Dolt database files (added by bd init)
.dolt/
*.db

# FB-03 CLI logs (v2 §5.4)
artifacts/remediation/logs/

# Field campaign artifacts: binaries, diagnostics, config backups (may contain secrets)
artifacts/field/
artifacts/field-runs/

# Field validation agent pack: contains access credentials, reports, local tooling
B4X_FIELD_VALIDATION_AGENT_PACK/

# Go build caches (docker volume bind mounts)
.go-cache/
.go-mod/


# Live router configs & field pack copies contain runtime secrets (ipinfo token, discovery secrets, web password hash)
/b4*.json
/b4x_field_validation_agent_pack.json

# Compiled helper binaries dropped on repo root during field sessions
/src/echprobe
/grok.md

# WARP reference repos (external clones for P1+ study, ~280MB)
/warp/

# Project-local Go module cache (WG layer: amneziawg-go lives here, not on C:)
/.go-modcache/
/.go-buildcache/

# UI build artifact (produced by pnpm build in CI)
src/http/ui/dist/

# UI build output (built by CI, placeholder never ships)
src/http/ui/dist/
